<!-- osd.xaml - Aviso flotante abajo en el centro (como el de volumen de Windows) al usar un atajo.
     No se activa ni roba el foco. El tamano se calcula en PcToolkit.ps1 (SizeToContent con WindowChrome
     deja una franja vacia). -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PC Toolkit aviso" Width="300" Height="64"
        WindowStyle="SingleBorderWindow" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        Background="Transparent" UseLayoutRounding="True"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource TextBrush}">
  <WindowChrome.WindowChrome>
    <WindowChrome GlassFrameThickness="0" CaptionHeight="0" ResizeBorderThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>
  <Border x:Name="Root" Background="{StaticResource OsdBrush}" Padding="18,12" MinWidth="260">
    <StackPanel Orientation="Horizontal">
      <TextBlock x:Name="Icon" Style="{StaticResource ToolIcon}"/>
      <StackPanel Margin="14,0,6,0" VerticalAlignment="Center">
        <TextBlock x:Name="Text" Style="{StaticResource Title}"/>
        <TextBlock x:Name="Detail" Style="{StaticResource Caption}"/>
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
