<!-- flyout.xaml - Panel flotante del gestor (abajo a la derecha, redondeado y con fondo acrilico).
     Ventana con borde normal (el acrilico de Windows no se pinta en ventanas sin marco) cuyo marco
     se elimina con WindowChrome. -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PC Toolkit" Width="380" SizeToContent="Height"
        WindowStyle="SingleBorderWindow" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        Background="Transparent" UseLayoutRounding="True"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource TextBrush}">
  <WindowChrome.WindowChrome>
    <WindowChrome x:Name="Chrome" GlassFrameThickness="-1" CaptionHeight="0" ResizeBorderThickness="0"
                  CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>

  <Border x:Name="Root" Background="{StaticResource TintBrush}">
    <Grid x:Name="Anim">
      <Grid.RenderTransform><TranslateTransform x:Name="Slide"/></Grid.RenderTransform>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- Cabecera -->
      <Grid Margin="10,10,10,4">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="BackButton" Style="{StaticResource IconButton}" Content="&#xE72B;" Visibility="Collapsed" AutomationProperties.Name="Atrás"/>
          <Image x:Name="Logo" Width="20" Height="20" Margin="8,0,2,0" VerticalAlignment="Center"/>
          <TextBlock x:Name="HeaderTitle" Text="PC Toolkit" FontSize="14" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
        <Button x:Name="SettingsButton" Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE713;" AutomationProperties.Name="Ajustes"/>
      </Grid>

      <!-- Aviso de error (se oculta solo) -->
      <Border x:Name="Banner" Grid.Row="1" Margin="12,4,12,0" Padding="12,8" CornerRadius="6"
              Background="{StaticResource CardBrush}" BorderBrush="{StaticResource DangerBrush}" BorderThickness="1" Visibility="Collapsed">
        <TextBlock x:Name="BannerText" Style="{StaticResource Caption}" Foreground="{StaticResource DangerBrush}"/>
      </Border>

      <ScrollViewer x:Name="Scroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" Focusable="False">
        <ContentControl x:Name="Page" Margin="12,0,12,14" Focusable="False"/>
      </ScrollViewer>
    </Grid>
  </Border>
</Window>
