{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "La Estantería",
  "version": "0.1.0",
  "identifier": "com.ikerlorente11.estanteria",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "La Estantería",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 480,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Spanish", "English"]
      }
    },
    "fileAssociations": [
      { "ext": ["cbz", "cbr", "cb7"], "name": "Cómic", "description": "Cómic (La Estantería)", "role": "Viewer" },
      { "ext": ["epub"], "name": "Libro EPUB", "description": "Libro (La Estantería)", "role": "Viewer" }
    ]
  }
}
