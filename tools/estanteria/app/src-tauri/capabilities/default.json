{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the web view may do: the settings file, open links outside, and the window itself",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-fullscreen",
    "core:window:allow-is-fullscreen",
    "store:default",
    "opener:default",
    "dialog:allow-open"
  ]
}
