<!-- window.xaml - Ventana de búsqueda de Everything (la abre el gestor con el atajo). Mismo aspecto que el
     panel: marco quitado con WindowChrome, esquinas redondeadas y fondo acrílico en Windows 11. -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Buscar archivos - PC Toolkit" Width="680" SizeToContent="Height"
        WindowStyle="SingleBorderWindow" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        Background="Transparent" UseLayoutRounding="True"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource TextBrush}">
  <WindowChrome.WindowChrome>
    <WindowChrome GlassFrameThickness="-1" CaptionHeight="0" ResizeBorderThickness="0"
                  CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>
  <Window.Resources>
    <!-- Resultado: fondo suave al pasar el ratón; el elegido, con la marca de color a la izquierda -->
    <Style x:Key="ResultItem" TargetType="ListBoxItem">
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Grid Margin="0,1">
              <Border x:Name="Bd" Background="Transparent" CornerRadius="5" Padding="12,6,10,6">
                <ContentPresenter/>
              </Border>
              <Border x:Name="Mark" Width="3" Height="18" CornerRadius="1.5" HorizontalAlignment="Left"
                      Background="{StaticResource AccentBrush}" Visibility="Collapsed"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SubtleBrush}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource CardHoverBrush}"/>
                <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border x:Name="Root" Background="{StaticResource TintBrush}">
    <StackPanel Margin="14,10,14,12">
      <!-- Cabecera (arrastrable) -->
      <Grid x:Name="Header" Background="Transparent" Margin="0,0,0,8">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Style="{StaticResource ToolIcon}" Text="&#xE721;" FontSize="16" Margin="2,0,0,0"/>
        <TextBlock Grid.Column="1" Text="Buscar archivos" FontSize="14" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
        <Button x:Name="Close" Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="12" AutomationProperties.Name="Cerrar"/>
      </Grid>

      <TextBox x:Name="Input" Style="{StaticResource Input}" FontSize="15" Padding="12,9"
               Tag="Escribe parte del nombre: informe, *.pdf, ext:mp4 vacaciones..." AutomationProperties.Name="Buscar archivos"/>

      <!-- Resultados -->
      <ListBox x:Name="List" Margin="0,8,0,0" MaxHeight="430" Background="Transparent" BorderThickness="0" Padding="0"
               Focusable="False" Visibility="Collapsed" ItemContainerStyle="{StaticResource ResultItem}"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True"
               VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
               AutomationProperties.Name="Resultados">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <Image Source="{Binding Icon}" Width="22" Height="22" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
              <StackPanel Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Name}" FontSize="13.5" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Location}" Style="{StaticResource Caption}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
              <TextBlock Grid.Column="2" Text="{Binding Detail}" Style="{StaticResource Caption}" TextWrapping="NoWrap" VerticalAlignment="Center"/>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <!-- Estado y acciones sobre el resultado elegido -->
      <Grid Margin="2,6,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock x:Name="Status" Style="{StaticResource Caption}" VerticalAlignment="Center" TextWrapping="NoWrap"/>
          <Button x:Name="StartEverything" Style="{StaticResource SubtleButton}" Content="Iniciar Everything" FontSize="12"
                  Padding="8,3" Margin="8,0,0,0" Visibility="Collapsed"/>
        </StackPanel>
        <StackPanel x:Name="Actions" Grid.Column="1" Orientation="Horizontal" Visibility="Collapsed">
          <Button x:Name="OpenFolder" Style="{StaticResource IconButton}" Content="&#xE838;" FontSize="13"
                  AutomationProperties.Name="Abrir ubicación" ToolTip="Abrir ubicación (Ctrl + Intro)"/>
          <Button x:Name="CopyPath" Style="{StaticResource IconButton}" Content="&#xE8C8;" FontSize="13"
                  AutomationProperties.Name="Copiar ruta" ToolTip="Copiar ruta (Ctrl + Mayús + C)"/>
        </StackPanel>
      </Grid>

      <TextBlock Style="{StaticResource Caption}" Margin="4,6,0,0" FontSize="11" TextWrapping="Wrap"
                 Text="Intro: abrir  ·  Ctrl + Intro: abrir ubicación  ·  Ctrl + Mayús + Intro: como administrador  ·  Ctrl + Mayús + C: copiar ruta  ·  Esc: cerrar"/>
    </StackPanel>
  </Border>
</Window>
