<!-- window.xaml - Ventana del Traductor (la abre el gestor con el atajo). Mismo aspecto que el panel:
     marco quitado con WindowChrome, esquinas redondeadas y fondo acrilico en Windows 11. -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Traductor - PC Toolkit" Width="600" SizeToContent="Height"
        WindowStyle="SingleBorderWindow" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        Background="Transparent" UseLayoutRounding="True"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource TextBrush}">
  <WindowChrome.WindowChrome>
    <WindowChrome GlassFrameThickness="-1" CaptionHeight="0" ResizeBorderThickness="0"
                  CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>
  <Window.Resources>
    <!-- Cuadro de varias lineas: como Input, pero con el texto arriba -->
    <Style x:Key="MultiInput" TargetType="TextBox">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="CaretBrush" Value="{StaticResource TextBrush}"/>
      <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="Padding" Value="12,10"/>
      <Setter Property="AcceptsReturn" Value="True"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Grid>
              <Border x:Name="Bd" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="6">
                <Grid>
                  <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Stretch"/>
                  <TextBlock x:Name="Hint" Text="{TemplateBinding Tag}" Margin="{TemplateBinding Padding}" Padding="2,0,0,0"
                             Foreground="{StaticResource SubBrush}" IsHitTestVisible="False" VerticalAlignment="Top" Visibility="Collapsed"/>
                </Grid>
              </Border>
              <Border x:Name="Line" Height="2" CornerRadius="0,0,6,6" VerticalAlignment="Bottom" Background="{StaticResource AccentBrush}" Visibility="Collapsed"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="Text" Value="">
                <Setter TargetName="Hint" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Line" Property="Visibility" Value="Visible"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- Texto traducido: seleccionable, sin borde ni fondo -->
    <Style x:Key="Output" TargetType="TextBox">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="IsReadOnly" Value="True"/>
      <Setter Property="IsReadOnlyCaretVisible" Value="False"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <ScrollViewer x:Name="PART_ContentHost" Background="Transparent"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border x:Name="Root" Background="{StaticResource TintBrush}">
    <StackPanel Margin="14,10,14,14">
      <!-- Cabecera (arrastrable) -->
      <Grid x:Name="Header" Background="Transparent" Margin="0,0,0,8">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Style="{StaticResource ToolIcon}" Text="&#xF2B7;" FontSize="16" Margin="2,0,0,0"/>
        <TextBlock Grid.Column="1" Text="Traductor" FontSize="14" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
        <Button x:Name="Close" Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="12" AutomationProperties.Name="Cerrar"/>
      </Grid>

      <!-- Idiomas -->
      <Grid Margin="0,0,0,8">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <ContentControl x:Name="SourceHost" Focusable="False"/>
        <Button x:Name="Swap" Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE8AB;" Margin="6,0"
                AutomationProperties.Name="Intercambiar idiomas" ToolTip="Intercambiar idiomas (Ctrl + Mayús + S)"/>
        <ContentControl x:Name="TargetHost" Grid.Column="2" Focusable="False"/>
      </Grid>

      <!-- Texto original -->
      <TextBox x:Name="Input" Style="{StaticResource MultiInput}" MinHeight="84" MaxHeight="200" MaxLength="5000"
               Tag="Escribe o pega el texto que quieras traducir" AutomationProperties.Name="Texto a traducir"/>

      <!-- Traducción -->
      <Border Style="{StaticResource Card}" Margin="0,8,0,0" Padding="12,10,8,8">
        <StackPanel>
          <TextBox x:Name="Output" Style="{StaticResource Output}" MinHeight="44" MaxHeight="240" AutomationProperties.Name="Traducción"/>
          <StackPanel x:Name="Dictionary" Margin="0,8,4,0" Visibility="Collapsed"/>
          <Grid Margin="0,6,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="Status" Style="{StaticResource Caption}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
            <Button x:Name="Copy" Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE8C8;" FontSize="13"
                    AutomationProperties.Name="Copiar traducción" ToolTip="Copiar traducción"/>
          </Grid>
        </StackPanel>
      </Border>

      <TextBlock Style="{StaticResource Caption}" Margin="4,8,0,0" FontSize="11"
                 Text="Intro: traducir  ·  Mayús + Intro: nueva línea  ·  Ctrl + Intro: copiar y cerrar  ·  Esc: cerrar"/>
    </StackPanel>
  </Border>
</Window>
