{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the web view may do: the settings file, open links outside, pick folders, the window itself (its light or dark theme, and made the mini player: its size, place, frame, always on top, dragged), and requests to any http or https server (any port) made by Rust",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-theme",
    "core:window:allow-set-size",
    "core:window:allow-set-position",
    "core:window:allow-set-min-size",
    "core:window:allow-set-decorations",
    "core:window:allow-set-always-on-top",
    "core:window:allow-set-resizable",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-start-dragging",
    "store:default",
    "opener:default",
    "dialog:allow-open",
    {
      "identifier": "http:default",
      "allow": [{ "url": "http://*:*" }, { "url": "https://*:*" }]
    }
  ]
}
