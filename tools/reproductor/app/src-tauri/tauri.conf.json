{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "El Reproductor",
  "version": "0.3.0",
  "identifier": "com.ikerlorente11.reproductor",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "El Reproductor",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 480,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Spanish",
          "English"
        ]
      }
    },
    "fileAssociations": [
      {
        "ext": [
          "mp3",
          "flac",
          "opus",
          "ogg",
          "oga",
          "m4a",
          "aac",
          "wav"
        ],
        "name": "Música",
        "description": "Canción (El Reproductor)",
        "role": "Viewer",
        "rank": "Alternate"
      }
    ]
  }
}
